# Pear Autoreplies — environment variables
# Copy to `.env` for local dev. Never commit `.env`.
# In production, these are loaded via Docker secrets / systemd EnvironmentFile.

# ---- Service ----
APP_ENV=development                             # development | staging | production
LOG_LEVEL=INFO

# ---- Bearer token for /admin/* endpoints ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=replace-me-with-a-long-random-string

# ---- Google service account (domain-wide delegation) ----
# Path inside the container; mount the JSON via docker-compose or systemd.
GOOGLE_APPLICATION_CREDENTIALS=/etc/pear-autoreply/sa.json

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Airtable ----
# PAT scoped to the Pear Tracker base only.
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appwPKlnV6YtbIjWz
# Table and field IDs live in src/autoreplies/services/airtable_schema.py —
# do not add them here. Only the base IDs above belong in .env.

# Set to a staging base ID for local dev. Leave blank to use prod.
AIRTABLE_STAGING_BASE_ID=

# ---- Supabase ----
SUPABASE_URL=https://fuacxndojzybijrqdbym.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ---- Slack ----
# Bot scope: chat:write
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#platform-leads

# ---- Redis (queue + idempotency state) ----
REDIS_URL=redis://redis:6379/0
DEDUP_TTL_DAYS=30

# ---- App-level rate limiting (replaces the Caddy /admin/* limiter on Render) ----
# /admin/* is also bearer-gated; this per-IP cap is blunt defense-in-depth.
# Set RATELIMIT_ENABLED=false to disable.
RATELIMIT_ENABLED=true
RATELIMIT_ADMIN_PER_MINUTE=30

# ---- Send timing ----
QUIET_HOURS_TZ=America/New_York
QUIET_HOURS_START=23           # 23:00 (11 PM)
QUIET_HOURS_END=7              # 07:00 (7 AM)
SEND_JITTER_MIN_SECONDS=120    # 2 min
SEND_JITTER_MAX_SECONDS=300    # 5 min

# ---- Humanization delay ----
HUMANIZATION_TIMEZONE=America/New_York
HUMANIZATION_WORKING_HOURS_START=8
HUMANIZATION_WORKING_HOURS_END=23        # 11 PM ET (hard ceiling per product spec)
HUMANIZATION_WITHIN_JITTER_MIN_SEC=60   # 1 min
HUMANIZATION_WITHIN_JITTER_MAX_SEC=300  # 5 min — hard ceiling
HUMANIZATION_OUT_JITTER_MIN_SEC=0
HUMANIZATION_OUT_JITTER_MAX_SEC=3600    # up to 1 hr after 8am

# ---- Production poller ----
# How often the production poller checks each primary mailbox (seconds).
POLLER_POLL_INTERVAL_SECONDS=60
# On first start, how far back to look for messages (seconds).
POLLER_BOOTSTRAP_LOOKBACK_SECONDS=60
# SQLite state file path — mounted via poller_state volume in docker-compose.
POLLER_STATE_PATH=/var/lib/pear-autoreply/poller.sqlite
# Duplicate-message dedupe window (seconds): suppress a re-send of the same
# inquiry within this window. 3600 (1h) covers StreetEasy re-sends (<=~16 min
# apart in practice) without suppressing genuine re-inquiries (>=~16 h apart).
# Shared by the production poller and the harness poller.
DEDUP_WINDOW_SECONDS=3600

# ---- Harness (kept during migration window — harness-poller still running) ----
# Test Airtable base (appmSm1FyerysvtcX). The same AIRTABLE_TOKEN PAT covers both bases.
AIRTABLE_TEST_BASE_ID=appmSm1FyerysvtcX
# How often the harness poller checks each autoreply mailbox (seconds).
HARNESS_POLL_INTERVAL_SECONDS=60
# On first start, how far back to look for messages (seconds).
HARNESS_BOOTSTRAP_LOOKBACK_SECONDS=60
# SQLite state file path — mounted via harness_state volume in docker-compose.
HARNESS_STATE_PATH=/var/lib/pear-autoreply/harness.sqlite
